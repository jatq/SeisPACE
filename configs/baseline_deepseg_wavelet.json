{
  "experiment": "wavelet_deepseg",
  "output_dir": "runs/wavelet_deepseg",
  "device": "cuda",
  "data": {
    "kind": "wavelet_mat",
    "root": "data/simulate_wavelet",
    "train_file": "training_data.mat",
    "test_file": "testing_data.mat",
    "normalization": "std",
    "window_normalization": "std",
    "inference_normalization": "window"
  },
  "transform": {
    "patch_length": 128,
    "overlap_ratio": 0.9,
    "num_segments": 15,
    "norm": "ortho"
  },
  "model": {
    "name": "deepseg",
    "embed_dim": 512,
    "base_channels": [32, 64, 128, 256, 128, 64, 32, 16]
  },
  "train": {
    "epochs": 500,
    "batch_size": 5,
    "lr": 0.01,
    "weight_decay": 0.00005,
    "scheduler_step": 10,
    "scheduler_gamma": 0.9,
    "loss": "mse",
    "snr_db": [-10.0, 10.0],
    "num_workers": 0,
    "amp": true,
    "seed": 42,
    "log_interval": 20
  },
  "eval": {
    "snr_db": [-10, -8, -6, -4, -2, 0, 2, 4, 6, 8, 10]
  }
}
